# ==========================================================================
# NEXUS CORE API — ENVIRONMENT VARIABLE SECRETS
# ==========================================================================

# Local Core Authorization API Key
NEXUS_API_KEY=local_nexus_secret_key_12345

# GitHub Personal Access Token (for commit / repo actions)
GITHUB_PAT=your_github_personal_access_token_here

# Telegram Bot configurations (for alerts push / poll commands)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Paid OpenAI Fallback credentials (disabled by default in config.yaml)
OPENAI_API_KEY=your_openai_api_key_here

# Paid xAI Fallback credentials (disabled by default in config.yaml)
XAI_API_KEY=your_xai_api_key_here
